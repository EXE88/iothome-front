# SmartLife frontend — every value that changes between machines lives here.
#
# Copy to `.env` and edit. `.env` is gitignored; this file is the committed
# template. Next.js reads both at startup, so changing either needs a restart
# of `npm run dev`.
#
# Anything prefixed NEXT_PUBLIC_ is compiled into the browser bundle and is
# therefore public. Everything else is read only by the Node process.

# ---------------------------------------------------------------------------
# Where Django is
# ---------------------------------------------------------------------------

# The address the *browser* calls, for the REST API and the WebSocket. On a
# phone or another machine this must be an address that phone can reach —
# "localhost" would mean the phone itself. Set it to whatever host you opened
# the site on: a LAN address, a Tailscale address, a domain.
#
# PICK ONE HOSTNAME AND STAY ON IT. `localhost:3000` and `127.0.0.1:3000` are
# the same site to you and two different sites to the browser: they do not
# share cookies, so each keeps its own login. Signing out of one leaves the
# other signed in, and drifting between them looks like the app randomly
# swapping your account. Whatever you choose here, open the site on the same
# host.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# The address the *Next.js server* calls for the auth route handlers.
# Defaults to NEXT_PUBLIC_API_BASE when unset.
#
# Keep this on 127.0.0.1 rather than "localhost": Node resolves "localhost" to
# ::1 first, and `manage.py runserver 0.0.0.0:8000` listens on IPv4 only, so
# every server-side call fails and login answers 404.
API_BASE_SERVER=http://127.0.0.1:8000

# Optional. The WebSocket origin, if it is not simply NEXT_PUBLIC_API_BASE with
# the scheme swapped for ws/wss — behind a proxy that terminates TLS, say.
# NEXT_PUBLIC_WS_BASE=

# ---------------------------------------------------------------------------
# The one hostname the site answers on
# ---------------------------------------------------------------------------

# When set, every request arriving under a different host is redirected here.
#
# This is what stops the account-swapping confusion: `localhost:3000` and
# `127.0.0.1:3000` are one site to you and two sites to the browser, with a
# separate cookie jar — and therefore a separate login — each. Sign out of
# one, sign in as somebody else, then type the other into the address bar, and
# the first account is still sitting there signed in.
#
# Pinning one host makes the second jar unreachable. Must match the host in
# NEXT_PUBLIC_API_BASE, and must be listed in the backend's
# CORS_ALLOWED_ORIGINS.
#
# Leave it EMPTY when the site has to answer on several addresses at once —
# testing from a phone over the LAN, for instance — and then keep to one
# address by hand for the length of a session.
NEXT_PUBLIC_SITE_ORIGIN=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------

# Lifetime of the httpOnly refresh cookie, in days. Must not exceed the
# backend's REFRESH_TOKEN_LIFETIME_DAYS or the cookie outlives the token it
# holds and the user sees a session that silently is not one.
REFRESH_COOKIE_MAX_AGE_DAYS=7

# How early, in seconds, to trade the access token in before it expires. A
# command is signed with the access token, so it must not lapse mid-flight.
NEXT_PUBLIC_ACCESS_REFRESH_MARGIN_SECONDS=120

# ---------------------------------------------------------------------------
# Development server
# ---------------------------------------------------------------------------

# Hosts allowed to pull /_next/* while running `npm run dev`. Without the host
# you actually typed in the address bar, the HTML renders but every chunk,
# font and optimized image is refused and the page comes up half-built.
#
# Comma-separated. Wildcards are allowed (`100.*.*.*`). Ignored by
# `next start` — production serves whatever host reaches it.
DEV_ORIGINS=localhost,127.0.0.1
